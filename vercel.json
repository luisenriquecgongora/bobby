{
  "buildCommand": "yarn workspace @bobby/web build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in dependabot/*) exit 0;; *) exit 1;; esac",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
