{
  "name": "bobby",
  "private": true,
  "description": "Bobby 🛠️ - 3D Spatial CAD Venue Builder & Object Constructor: React/Three.js/Tauri Frontend + Python 3.12 Authoritative Geometry Microservice",
  "license": "MIT",
  "packageManager": "yarn@1.22.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:engine": "uvicorn src.main:app --app-dir services/bobby-engine --reload",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:engine": "pytest services/bobby-engine",
    "test:all": "turbo run test && pytest services/bobby-engine",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
