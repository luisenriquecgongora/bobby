{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore: release v${version}",
  "bootstrap-sha": "87bd596b9eaf140e3e934d4e0bc83d1262e97b04",
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/desktop/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/connector-plaato/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/editor/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/engine/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/viewer/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/desktop/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "apps/desktop/src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "services/bobby-engine/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        "services/bobby-engine/src/config.py",
        "services/bobby-engine/src/__init__.py"
      ]
    }
  }
}
