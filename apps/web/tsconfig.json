{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@bobby/core": ["../../packages/core/src"],
      "@bobby/engine": ["../../packages/engine/src"],
      "@bobby/editor": ["../../packages/editor/src"],
      "@bobby/viewer": ["../../packages/viewer/src"],
      "@bobby/connector-plaato": ["../../packages/connector-plaato/src"]
    }
  },
  "include": ["src"]
}
