{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plaato Studio",
  "version": "0.1.0",
  "identifier": "org.openvenue.studio",
  "build": {
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "devUrl": "http://localhost:3301",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Plaato Studio - OpenVenue3D",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: http:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["venue"],
        "name": "Plaato Venue 3D Project",
        "description": "3D Venue Spatial Layout File",
        "role": "Editor"
      }
    ]
  }
}
