{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@bobby/core": ["../core/src"],
      "@bobby/engine": ["../engine/src"],
      "@bobby/viewer": ["../viewer/src"],
      "@bobby/connector-plaato": ["../connector-plaato/src"]
    }
  },
  "include": ["src/**/*"]
}
